# Copy to .env and fill in — never commit the real values.
# Used by `scripts/create_secrets.py` to create the Modal secret "muse-model-api".

# Meta Model API key for Muse Spark 1.3 (chat) and Muse Image 1.0 (images).
# Get it from the Model API dashboard: https://dev.meta.ai  (keys start with LLM_)
MODEL_API_KEY=LLM_your_key_here

# Hugging Face token with access to the gated meta-llama/Llama-3.2-3B repo.
HF_TOKEN=hf_your_token_here

# Optional overrides
# TRIBE_GPU=L40S
# TRIBE_USE_LLM=true
# ROI_ATLAS=mesh
